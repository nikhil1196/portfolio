# ============================================================
# Security hardening — Apache 2.4+
# ============================================================

# No directory listing
Options -Indexes

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header set Cross-Origin-Opener-Policy "same-origin"
    # Remove fingerprinting headers
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

# Hide PHP version from response headers
<IfModule mod_php.c>
    php_flag expose_php off
</IfModule>

# Block access to sensitive / hidden files
<FilesMatch "(^\.|mail-config\.php|composer\.(json|lock)|\.md$|\.log$|\.sql$)">
    Require all denied
</FilesMatch>

# Block common exploit probes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} (wp-config|\.env|\.git|phpinfo|config\.php\.bak) [NC]
    RewriteRule .* - [F,L]
</IfModule>
